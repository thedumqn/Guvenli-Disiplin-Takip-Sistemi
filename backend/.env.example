# Server
NODE_ENV=development
PORT=5000

# MongoDB (yerel: mongodb://localhost:27017/disiplin | Atlas: mongodb+srv://KULLANICI:SIFRE@cluster.mongodb.net/disiplin)
MONGODB_URI=mongodb://localhost:27017/disiplin

# Alan sifrelemesi icin 32 baytlik hex anahtar. Uretmek icin:
#   openssl rand -hex 32
# veya: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=

# JWT anahtarlari. Uretmek icin: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Cookie imzalama anahtari. Uretmek icin: openssl rand -base64 32
COOKIE_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Password
MIN_PASSWORD_LENGTH=12
BCRYPT_SALT_ROUNDS=12

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
